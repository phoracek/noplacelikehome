# Copy this file to ansible/group_vars/server.yml and fill in real values.
# The real file is gitignored, following the other labs' convention.

# The user created by Raspberry Pi Imager during flashing. Only
# create_ansible_user.yml connects as this user; every later playbook runs as
# the ansible user it creates.
bootstrap_user: petr

# Public key installed for the ansible user. Must be a key Ansible can use
# non-interactively — passphrase-free, or loaded into an agent that the
# ansible-playbook run can reach.
ssh_public_key: ~/.ssh/id_ed25519.pub
