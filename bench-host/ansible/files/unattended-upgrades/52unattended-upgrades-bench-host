// Local overrides on top of the packaged 50unattended-upgrades — a separate
// file so package upgrades never leave a .dpkg-dist conflict behind.

// Origins-Pattern entries from multiple apt.conf.d files append, so this adds
// to the Debian + Debian-Security defaults from 50unattended-upgrades rather
// than replacing them. Raspberry Pi OS pulls the kernel, firmware and
// Pi-specific packages from archive.raspberrypi.com, which the defaults don't
// cover — without this entry those packages would never auto-update.
Unattended-Upgrade::Origins-Pattern {
        "origin=Raspberry Pi Foundation,codename=${distro_codename},label=Raspberry Pi Foundation";
        // 32-bit Raspberry Pi OS ships from a different archive; a no-op on
        // the 64-bit install but keeps this file correct for either image.
        "origin=Raspbian,codename=${distro_codename},label=Raspbian";
};

// Headless box with nothing depending on it yet — reboot when a kernel or
// firmware update needs it, at night, instead of running patched-on-disk but
// unpatched-in-memory indefinitely.
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:00";

// Keep the small SD card from filling up with old kernels and orphans.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
