[Unit]
Description=Syncthing continuous file synchronization
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/syncthing/syncthing:latest
ContainerName=syncthing
# Two distinct traffic planes:
#   * The web GUI / REST API (8384) is internal-only — it joins the shared network
#     with Caddy and publishes no host port, reachable only via Caddy at
#     https://syncthing.lab.pacmag.cz, where it's gated by VoidAuth (see Caddyfile).
#   * The sync protocol does NOT go through Caddy (it's not HTTP), so its ports are
#     published directly on the host below, exactly like Forgejo's SSH port. The
#     VoidAuth edge gate on the GUI therefore never touches sync traffic.
Network=forgejo.network
# Direct device-to-device sync (BEP). Both transports are needed: TCP for the
# connection itself, UDP for QUIC. Without an inbound 22000 a peer can still
# connect via Syncthing's relays, but published ports give direct, fast links.
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp
# Local (LAN) peer discovery broadcasts. Harmless to publish; lets devices on the
# host's subnet find this instance without the global discovery server.
PublishPort=21027:21027/udp
# Bind the GUI to all interfaces inside the container so Caddy (a separate
# container on the shared network) can reach it; the image otherwise binds the GUI
# to 127.0.0.1 and would be unreachable from the proxy.
Environment=STGUIADDRESS=0.0.0.0:8384
# The official image runs syncthing as PUID/PGID (default 1000:1000) after dropping
# from root, so the bind-mount host dir must be owned by 1000:1000 (rootful Podman
# maps container uid 1000 to host uid 1000) or syncthing can't write its config,
# keys, or index database. Ansible creates the dir with that ownership first —
# Podman won't create the bind-mount source.
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Prague
# Single VOLUME the image is built around: holds the config + TLS device keys +
# index database under /var/syncthing/config and the default synced folders under
# /var/syncthing. Mounting the whole tree keeps every bit of state on the host.
Volume=/var/lib/homelab/syncthing:/var/syncthing:Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
