# Kept plaintext on port 80 — placeholder health endpoint.
http://t470s.lab.pacmag.cz {
	respond "OK" 200
}

# Shared TLS config for every internal site below. ACME DNS-01 via the vendored
# WEDOS DNS provider — required because every *.lab.pacmag.cz name resolves only
# to a private IP, so the HTTP-01 and TLS-ALPN challenges can't reach this host.
# Credentials come from the container environment (WEDOS_USERNAME / WEDOS_PASSWORD).
(wedos_tls) {
	tls {
		dns wedos {
			username {env.WEDOS_USERNAME}
			password {env.WEDOS_PASSWORD}
		}
		# WEDOS enforces a 300s minimum TTL (and a long SOA negative-cache TTL), so
		# a freshly added token stays hidden behind cached DNS responses for a
		# while. Present the token and poll public recursive resolvers — the kind
		# Let's Encrypt uses — until it is actually visible, then validate. The
		# generous timeout (matching lego's WEDOS default of 10min) absorbs that
		# delay. We check via these resolvers rather than the zone's authoritative
		# nameservers because the container can't reach the WEDOS NS on :53.
		resolvers 1.1.1.1 8.8.8.8 9.9.9.9
		propagation_delay 30s
		# Ceiling, not a fixed wait: in steady state the check passes in seconds.
		# Set high enough to outlast WEDOS's long SOA negative-cache TTL on the
		# rare occasion the _acme-challenge name was recently seen as NXDOMAIN
		# (e.g. right after a cleanup/purge).
		propagation_timeout 1800s
	}
}

# Shared edge auth for the services with no login of their own (Glances and
# Dashy). Caddy clones each request to VoidAuth's
# forward-auth endpoint (the voidauth container on the shared network); VoidAuth
# checks the x-voidauth-session cookie against its ProxyAuth Domain rules and
# returns 2xx to allow or a redirect to its login page to deny. On success the
# Remote-* identity headers are copied onto the request for any downstream app
# that supports trusted-header SSO. VoidAuth itself (auth.lab.pacmag.cz) is the
# one site NOT wrapped in this — it is the login portal.
(voidauth) {
	forward_auth voidauth:3000 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

forge.lab.pacmag.cz {
	import wedos_tls
	# Forgejo is NOT placed behind forward_auth: the CI runners, git-over-HTTPS,
	# and the API all reach this same vhost and authenticate with tokens, which
	# carry no VoidAuth session cookie — a proxy gate would 302-redirect and break
	# them. Forgejo instead uses VoidAuth as an OIDC login source (configured in
	# its admin UI), so SSO covers the web UI while tokens keep working.
	reverse_proxy forgejo:3000
}

# VoidAuth — the SSO/auth provider and login portal. Plain reverse proxy: this is
# the one internal site that must stay reachable without auth, since it's what the
# forward_auth gates above and Forgejo's OIDC flow redirect users to.
auth.lab.pacmag.cz {
	import wedos_tls
	reverse_proxy voidauth:3000
}

glances.t470s.lab.pacmag.cz {
	import wedos_tls
	# Glances' web UI has no authentication of its own and, because the container
	# runs with --pid=host, exposes every host process's full command line (which
	# routinely leaks secrets passed as CLI args). Gate it at the edge with
	# VoidAuth SSO.
	import voidauth
	reverse_proxy glances:61208
}

lab.pacmag.cz {
	import wedos_tls
	# Dashy has no login of its own; gate it at the edge with VoidAuth SSO.
	import voidauth
	reverse_proxy dashy:8080
}

grist.lab.pacmag.cz {
	import wedos_tls
	# Unlike Glances/Dashy, Grist is NOT placed behind the forward_auth gate: it
	# authenticates users itself via OIDC against VoidAuth (per-user accounts) and
	# must receive the OIDC callback at /oauth2/callback, so Caddy just proxies it.
	# GRIST_FORCE_LOGIN means anonymous browser hits are redirected to the OIDC
	# login by Grist; API clients' `Authorization: Bearer <api-key>` is validated by
	# Grist directly. reverse_proxy upgrades Grist's WebSockets automatically.
	reverse_proxy grist:8484
}

syncthing.lab.pacmag.cz {
	import wedos_tls
	# This vhost is ONLY the Syncthing web GUI / REST API (port 8384). Syncthing has
	# an optional GUI login of its own, but we gate at the edge with VoidAuth SSO for
	# consistency with the other admin UIs (Glances/Dashy) — the GUI exposes every
	# synced folder path and device key, so it must not sit open on the network.
	# Sync traffic (port 22000) bypasses Caddy entirely via published host ports, so
	# this forward_auth gate does not — and cannot — interfere with synchronization.
	import voidauth
	reverse_proxy syncthing:8384
}

ramus-mcp.lab.pacmag.cz {
	import wedos_tls

	# /reopen and /probe-reset take no token and are localhost-only recovery
	# endpoints (hit on 127.0.0.1 directly) — never expose them at the edge.
	@maint path /reopen /probe-reset
	respond @maint 403

	# Gate ONLY the token-minting route (creds templated by Ansible from the
	# gitignored group_vars, same as the Glances ones). Every other route is
	# either capability-URL-protected — the upload/stream/socket endpoints
	# (/flash/<id>, /attach/<id>, /midi/<id>) and the one-time recording
	# downloads (/audio/<id>, deleted on read) carry their own unguessable lock
	# token as the credential — or deliberately open: the MCP transport (/sse,
	# /messages/), which Claude Code cannot send basic auth on, and the read-only
	# redacted diagnostics (/api/v1/logs, /api/v1/diagnose) that are needed
	# exactly when things break. See tools/agentic/hardware/mcp-server/README.md.
	#
	# Keep this matcher in sync with the server's route table: any new route that
	# mints or leaks a lock token must be added here, or it is reachable without
	# credentials.
	@mint path /api/v1/lock
	basic_auth @mint {
		{$RAMUS_MCP_BASIC_AUTH_USER} {$RAMUS_MCP_BASIC_AUTH_PASSWORD_HASH}
	}

	# The bench MCP runs as a host systemd service (needs local USB/probe-rs/ALSA),
	# not a container, so Caddy reaches it across the boundary via the host gateway.
	# The server's transport-security allowlist now trusts this public hostname
	# (HARDWARE_MCP_PUBLIC_BASE_URL on the unit), so we forward the real Host — no
	# loopback spoof, and no hidden coupling to the listener's port.
	reverse_proxy host.containers.internal:8766
}
