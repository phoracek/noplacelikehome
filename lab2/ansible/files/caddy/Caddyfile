# Kept plaintext on port 80 — placeholder health endpoint.
http://t470s.lab.pacmag.cz {
	respond "OK" 200
}

# Shared TLS config for every internal site below. ACME DNS-01 via the vendored
# WEDOS DNS provider — required because every *.lab.pacmag.cz name resolves only
# to a private IP, so the HTTP-01 and TLS-ALPN challenges can't reach this host.
# Credentials come from the container environment (WEDOS_USERNAME / WEDOS_PASSWORD).
(wedos_tls) {
	tls {
		dns wedos {
			username {env.WEDOS_USERNAME}
			password {env.WEDOS_PASSWORD}
		}
		# WEDOS enforces a 300s minimum TTL (and a long SOA negative-cache TTL), so
		# a freshly added token stays hidden behind cached DNS responses for a
		# while. Present the token and poll public recursive resolvers — the kind
		# Let's Encrypt uses — until it is actually visible, then validate. The
		# generous timeout (matching lego's WEDOS default of 10min) absorbs that
		# delay. We check via these resolvers rather than the zone's authoritative
		# nameservers because the container can't reach the WEDOS NS on :53.
		resolvers 1.1.1.1 8.8.8.8 9.9.9.9
		propagation_delay 30s
		# Ceiling, not a fixed wait: in steady state the check passes in seconds.
		# Set high enough to outlast WEDOS's long SOA negative-cache TTL on the
		# rare occasion the _acme-challenge name was recently seen as NXDOMAIN
		# (e.g. right after a cleanup/purge).
		propagation_timeout 1800s
	}
}

# ramus-mcp.lab.pacmag.cz is the only *.lab.pacmag.cz name served from this host;
# the rest are served by ../lab3. Never add a vhost here for a name lab3 also
# serves: both hosts would renew the same certificate and collide on the single
# shared _acme-challenge TXT record.

ramus-mcp.lab.pacmag.cz {
	import wedos_tls

	# /reopen and /probe-reset take no token and are localhost-only recovery
	# endpoints (hit on 127.0.0.1 directly) — never expose them at the edge.
	@maint path /reopen /probe-reset
	respond @maint 403

	# Gate ONLY the token-minting route (creds templated by Ansible from the
	# gitignored group_vars). Every other route is
	# either capability-URL-protected — the upload/stream/socket endpoints
	# (/flash/<id>, /attach/<id>, /midi/<id>) and the one-time recording
	# downloads (/audio/<id>, deleted on read) carry their own unguessable lock
	# token as the credential — or deliberately open: the MCP transport (/sse,
	# /messages/), which Claude Code cannot send basic auth on, and the read-only
	# redacted diagnostics (/api/v1/logs, /api/v1/diagnose) that are needed
	# exactly when things break. See tools/agentic/hardware/mcp-server/README.md.
	#
	# Keep this matcher in sync with the server's route table: any new route that
	# mints or leaks a lock token must be added here, or it is reachable without
	# credentials.
	@mint path /api/v1/lock
	basic_auth @mint {
		{$RAMUS_MCP_BASIC_AUTH_USER} {$RAMUS_MCP_BASIC_AUTH_PASSWORD_HASH}
	}

	# The bench MCP runs as a host systemd service (needs local USB/probe-rs/ALSA),
	# not a container, so Caddy reaches it across the boundary via the host gateway.
	# The server's transport-security allowlist now trusts this public hostname
	# (HARDWARE_MCP_PUBLIC_BASE_URL on the unit), so we forward the real Host — no
	# loopback spoof, and no hidden coupling to the listener's port.
	reverse_proxy host.containers.internal:8766
}
