# Copy this file to ansible/group_vars/server.yml and fill in real values.
# The real file is gitignored — credentials never enter the repo.
#
# WEDOS WAPI credentials used by Caddy to solve the ACME DNS-01 challenge for
# forge.lab.pacmag.cz. Pass the plain WAPI password here — the vendored provider
# hashes it per request (sha1(user + sha1(password) + current Prague hour)).
#
# Enabling WAPI in the WEDOS customer administration
# --------------------------------------------------
# (https://client.wedos.cz/ for CZ accounts, or https://client.wedos.global/).
# A WEDOS account with active credit is required.
#
#   1. Log in to the customer administration. From the top menu open
#      "My Account / Customer", then choose "WAPI" in the left menu (on the
#      global panel, "WAPI" is directly in the left sidebar).
#   2. In the "WAPI Setup" form:
#        - Allowed IPs: a comma-separated list of the IPs WAPI may be called
#          from. Enter the lab's *outbound public IP* (the address that egresses
#          to the internet — what `curl -s ifconfig.me` returns from the T470s).
#          WAPI rejects calls from any other source IP. Update this if your home
#          public IP changes.
#        - Preferred protocol: set to JSON (the provider calls the JSON endpoint).
#        - Notification mode: leave at the default.
#      Click "Set".
#   3. In the "Password Settings" form, enter a dedicated WAPI password twice and
#      click "Set". This is NOT your account login password — the login password
#      does not work for WAPI.
#   4. Changes take effect within ~30 minutes.
#
# Then fill in below: wedos_username is your WEDOS account login (the same
# account WAPI was enabled on); wedos_password is the WAPI password from step 3.

wedos_username: "your-wedos-account-login"
wedos_password: "your-wapi-password"

# Forgejo Actions runners. Each entry becomes one systemd unit, one container,
# and one data dir (/var/lib/homelab/<name>/). Add or remove entries to change
# how many runners run — the playbooks loop over this list. They serve the forge
# at https://forge.lab.pacmag.cz, which runs on the OptiPlex (../../lab3): these
# credentials are validated against rows in that host's gitea.db, so neither side
# is much use restored without the other.
#
# To get the uuid + token for an entry: in Forgejo open
# Site Administration → Actions → Runners → "Create new runner". The page shows
# a UUID and a registration token (the token is shown once — copy both). Paste
# them below, replacing the PASTE_* placeholders.
#
# Entries left with the PASTE_* placeholders are skipped: no config.yml is
# written and the runner is not started, so you can commit-then-fill at your
# own pace.
forgejo_runners:
  - name: forgejo-runner-1
    uuid: "PASTE_UUID_HERE"
    token: "PASTE_TOKEN_HERE"
  - name: forgejo-runner-2
    uuid: "PASTE_UUID_HERE"
    token: "PASTE_TOKEN_HERE"

# Credentials gating the hardware-bench MCP control channel (acquire_lock,
# served behind Caddy at https://ramus-mcp.lab.pacmag.cz). ramus_mcp_basic_auth_password_hash
# is a bcrypt hash (pip install bcrypt):
#
#   python3 -c 'import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass("Password: ").encode(), bcrypt.gensalt(14)).decode())'
ramus_mcp_basic_auth_user: "petr"
ramus_mcp_basic_auth_password_hash: "REPLACE_WITH_BCRYPT_HASH"

# Hardware bench MCP (deploy_services_ramus_mcp.yml). Runs as a dedicated, unprivileged
# system user that the play creates (home under /var/lib/<user>, nologin shell) -
# not a human account.
#
# ramus_mcp_src_dir is the ramus repo root on the CONTROL NODE (the machine you run
# ansible from); the play rsyncs the mcp-server tree + tools/probe-utils.sh from
# there to ramus_mcp_repo_dir on the T470s. Keep ramus_mcp_repo_dir out of a 0700
# home dir so the service user can read it (the default sits in its own home).
ramus_mcp_service_user: "ramus-mcp"
ramus_mcp_src_dir: "/home/petr/Code/ramus/instance-agentic-move-to-homelab"
ramus_mcp_repo_dir: "/var/lib/ramus-mcp/instance-agentic-move-to-homelab"

# ALSA capture device for record_audio (passed to `ffmpeg -f alsa -i` via
# HARDWARE_MCP_AUDIO_DEVICE on the unit). "default" works until the bench mic's
# id is pinned — find it on the host with `arecord -l` / `arecord -L` and set
# e.g. "plughw:CARD=Micro,DEV=0".
ramus_mcp_audio_device: "default"
