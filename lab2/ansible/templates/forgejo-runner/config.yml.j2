log:
  level: info

server:
  connections:
    forgejo:
      url: https://forge.lab.pacmag.cz/
      uuid: {{ runner.uuid }}
      token: {{ runner.token }}

runner:
  labels:
    - docker:docker://node:20-bookworm
    - ubuntu-latest:docker://node:20-bookworm

# No `container.options` block: the forge runs on another host and its name
# resolves through ordinary DNS, so job containers need no /etc/hosts pin to
# reach the server URL above or to pull from its registry.
