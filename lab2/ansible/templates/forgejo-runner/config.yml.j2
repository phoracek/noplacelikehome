log:
  level: info

server:
  connections:
    forgejo:
      url: https://forge.lab.pacmag.cz/
      uuid: {{ runner.uuid }}
      token: {{ runner.token }}

runner:
  labels:
    - docker:docker://node:20-bookworm
    - ubuntu-latest:docker://node:20-bookworm

# Passed to `docker run` when the runner spawns a job container as a
# sibling. The runner itself has AddHost=forge.lab.pacmag.cz:host-gateway in
# its Quadlet, but that doesn't propagate — job containers need their own
# /etc/hosts entry, otherwise actions/checkout@v4 can't resolve the Forgejo
# server URL configured above (the web UI is published only via Caddy on the
# host, reached here through the host gateway).
container:
  options: "--add-host=forge.lab.pacmag.cz:host-gateway"
