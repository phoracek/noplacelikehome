[Unit]
Description=Glances system monitor
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/nicolargo/glances:latest
ContainerName=glances
# No login: deploy_glances.yml opens 61208 to the OptiPlex's Caddy only.
Network=host
Environment="GLANCES_OPT=-w -C /glances/conf/glances.conf"
Environment=TZ=Europe/Prague
# Report the host's processes and OS.
PodmanArgs=--pid=host
Volume=/etc/os-release:/etc/os-release:ro
Volume=/etc/glances/glances.conf:/glances/conf/glances.conf:ro,Z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
