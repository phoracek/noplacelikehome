log:
  level: info

server:
  connections:
    forgejo:
      url: https://forge.lab.pacmag.cz/
      uuid: {{ runner.uuid }}
      token: {{ runner.token }}

runner:
  labels:
    - docker:docker://node:20-bookworm
    - ubuntu-latest:docker://node:20-bookworm

cache:
  enabled: true
  # One cache server (forgejo-cache.container) shared by every runner, instead
  # of each runner spawning its own: with per-runner stores a job only got a
  # cache hit when it landed on the runner that saved the entry. The trailing
  # slash is required. Each runner still runs its own cache proxy, which is
  # what job containers talk to; host/proxy_port stay auto-detected.
  external_server: http://forgejo-cache:4000/
  secret_url: file:/etc/forgejo-runner/cache-secret

container:
  # Re-pull the job image on every run instead of trusting the host's cached
  # copy. Workflows reference `:latest` tags in this forge's own registry, so a
  # stale cache fails a job as if the repo's own code were broken while the
  # registry holds a correct image — a deceptive failure that looks like a
  # missing build dependency. The registry is on this host, so an unchanged
  # image costs a manifest check, not a re-download.
  force_pull: true
  # The forge is on this host but is reached by its public name, which resolves
  # to the host's LAN address, so job containers need no /etc/hosts pin to reach
  # the server URL above or to pull from its registry.
  #
  # cpu-shares below the Docker/Podman default (1024) so job containers get
  # proportionally less CPU than the host's other services whenever there's
  # contention — a busy CI run must not be able to starve Home Assistant et al.
  options: --cpu-shares=128
