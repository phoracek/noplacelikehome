[Unit]
Description=Prune forgejo-imagebuild's rootless Podman layer store
Documentation=man:podman-system-prune(1)

[Service]
Type=oneshot
# The layer store persists between builds on purpose (that is the cache), so
# nothing else ever shrinks it: each change to the Containerfile leaves one more
# image version behind. The ephemeral job container used to throw all of this
# away for free after every run.
#
# Dangling images only: each rebuild moves the image's tag to the new build and
# leaves the old one untagged, and this collects those. Tagged images are kept
# whatever their age — deliberately no --all. The ramus workflow has no
# registry layer cache, so this store is the only cache it has: --all would
# delete the current image and its base (fedora:44) once they're older than the
# filter, and every build after that prune would start cold.
ExecStart=/usr/bin/podman system prune --force
