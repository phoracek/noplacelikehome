[Unit]
Description=Prune forgejo-imagebuild's rootless Podman layer store
Documentation=man:podman-system-prune(1) man:podman-image-prune(1)

[Service]
Type=oneshot
# The layer store persists between builds on purpose (that is the cache), so
# nothing else ever shrinks it: each change to the Containerfile leaves one more
# image version behind. The ephemeral job container used to throw all of this
# away for free after every run.
#
# Everything not used by a container and older than a week — one week, not
# two, because the store shares the host's only filesystem (/) with everything
# else. `until` matches on image creation time, so a base image older than that
# (fedora:44) goes too and is re-pulled by the next build — an acceptable cost
# once a week.
ExecStart=/usr/bin/podman system prune --all --force --filter until=168h
# Then dangling images of any age: superseded :latest builds younger than the
# cutoff above.
ExecStart=/usr/bin/podman image prune --force
