[Unit]
Description=Clouds over Czechoslovakia (HTTP server)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=clouds-over-czechoslovakia-server
# Internal-only: it joins the shared network with Caddy and publishes no host
# port, reachable only via Caddy at clouds.lab.pacmag.cz. nginx serves on port 80
# inside the container.
Network=homelab.network
# Read-only view of what the generator container writes; :z because the label is
# shared between the two (see clouds-over-czechoslovakia.container).
Volume=/var/lib/homelab/clouds-over-czechoslovakia:/usr/share/nginx/html:ro,z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
