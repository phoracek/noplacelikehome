[Unit]
Description=Mosquitto MQTT broker
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/eclipse-mosquitto:2
ContainerName=mosquitto
Network=host
Volume=/var/lib/homelab/mosquitto/config:/mosquitto/config:ro,Z
Volume=/var/lib/homelab/mosquitto/data:/mosquitto/data:Z
Volume=/var/lib/homelab/mosquitto/log:/mosquitto/log:Z
AutoUpdate=registry

[Service]
# Weighted above the default (100) so CPU/IO contention from Forgejo's CI job
# containers can't starve this service.
CPUWeight=300
IOWeight=300
# Reserved core (carved out of machine.slice in install_podman.yml)
# so a busy CI run can never delay scheduling here — shared with Home Assistant
# and Zigbee2MQTT, which broker through this.
AllowedCPUs=0
Restart=always

[Install]
WantedBy=multi-user.target default.target
