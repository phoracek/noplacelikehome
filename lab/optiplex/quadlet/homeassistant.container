[Unit]
Description=Home Assistant
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/home-assistant/home-assistant:stable
ContainerName=homeassistant
Network=host
Volume=/var/lib/homelab/homeassistant:/config:Z
Volume=/etc/localtime:/etc/localtime:ro
Volume=/run/dbus:/run/dbus:ro
AutoUpdate=registry

[Service]
# Weighted above the default (100) so CPU/IO contention from Forgejo's CI job
# containers can't starve this service.
CPUWeight=300
IOWeight=300
# Reserved core (carved out of machine.slice in install_podman.yml)
# so a busy CI run can never delay scheduling here — shared with Zigbee2MQTT and
# Mosquitto, which it talks to on the same event loop.
AllowedCPUs=0
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
