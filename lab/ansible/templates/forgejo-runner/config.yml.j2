log:
  level: info

server:
  connections:
    forgejo:
      url: http://home.local:8128/
      uuid: {{ runner.uuid }}
      token: {{ runner.token }}

runner:
  labels:
    - docker:docker://node:20-bookworm
    - ubuntu-latest:docker://node:20-bookworm

# Passed to `docker run` when the runner spawns a job container as a
# sibling. The runner itself has AddHost=home.local:host-gateway in its
# Quadlet, but that doesn't propagate — job containers need their own
# /etc/hosts entry, otherwise actions/checkout@v4 can't resolve the
# Forgejo server URL configured above.
#
# The /pages bind mount makes the host's static-site directory writable
# from inside every job, so a publish step is just `cp -r dist/.
# /pages/<owner>/<repo>/`. The :z is critical: nginx in the pages
# Quadlet mounts the same dir, and shared SELinux labelling is what
# lets both containers touch it.
container:
  options: "--add-host=home.local:host-gateway --volume=/var/lib/homelab/pages:/pages:z"
