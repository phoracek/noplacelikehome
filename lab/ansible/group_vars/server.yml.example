# Copy this file to ansible/group_vars/server.yml and fill in real values.
# The real file is gitignored — credentials never enter the repo.
#
# Generate one (UUID, token) pair per runner in Forgejo:
#   Site Administration -> Actions -> Runners -> "Create new runner"
# The token is shown only once on that page.
#
# Add more runners by appending entries. Each runner's `name` becomes
# the systemd unit (`<name>.service`), the container name, and the
# on-disk data dir (`/var/lib/homelab/<name>/`); pick something stable
# because renaming abandons existing state. Entries still carrying the
# PASTE_*_HERE placeholders are skipped — handy for staging a slot
# before you've cut the token in Forgejo.

forgejo_runners:
  - name: forgejo-runner
    uuid: "PASTE_UUID_HERE"
    token: "PASTE_TOKEN_HERE"
  - name: forgejo-runner-2
    uuid: "PASTE_UUID_HERE"
    token: "PASTE_TOKEN_HERE"
