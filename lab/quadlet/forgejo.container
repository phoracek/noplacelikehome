[Unit]
Description=Forgejo
After=network-online.target
Wants=network-online.target

[Container]
# Codeberg's registry only publishes versioned tags (no :latest). The
# major-only tag floats to the newest minor/patch in the 15.x series;
# bump the major manually when a new Forgejo major releases.
Image=codeberg.org/forgejo/forgejo:15
ContainerName=forgejo
PublishPort=8128:3000
Volume=/var/lib/homelab/forgejo/gitea:/data/gitea:Z
Volume=/var/lib/homelab/forgejo/git:/data/git:Z
Volume=/var/lib/homelab/forgejo/var:/var/lib/gitea:Z
Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=FORGEJO__server__HTTP_PORT=3000
Environment=FORGEJO__server__ROOT_URL=http://home.local:8128/
Environment=FORGEJO__server__DOMAIN=home.local
Environment=FORGEJO__server__DISABLE_SSH=true
Environment=FORGEJO__server__START_SSH_SERVER=false
Environment=FORGEJO__database__DB_TYPE=sqlite3
Environment=FORGEJO__actions__ENABLED=true
Environment=FORGEJO__actions__DEFAULT_ACTIONS_URL=https://code.forgejo.org
Environment=TZ=Europe/Prague
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
