[Unit]
Description=Pages (static sites published by Forgejo Actions)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=pages
PublishPort=8129:80
Volume=/var/lib/homelab/pages:/usr/share/nginx/html:ro,z
AddHost=home.local:host-gateway
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
