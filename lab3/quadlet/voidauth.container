[Unit]
Description=VoidAuth single sign-on / auth provider
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/voidauth/voidauth:latest
ContainerName=voidauth
# Internal-only: joins the shared network with Caddy and publishes no host port,
# reached only via Caddy at https://auth.lab.pacmag.cz. VoidAuth serves on port
# 3000 inside the container. It is the one vhost NOT placed behind forward_auth —
# it IS the login portal.
Network=homelab.network
# Config (logo, email templates) and the SQLite database live on bind mounts.
# Podman won't create the bind-mount sources, so Ansible makes both dirs first.
Volume=/var/lib/homelab/voidauth/config:/app/config:Z
Volume=/var/lib/homelab/voidauth/db:/app/db:Z
# Single-user homelab: use the bundled SQLite adapter (db.sqlite under /app/db)
# rather than running a separate Postgres container.
Environment=DB_ADAPTER=sqlite
# The full external URL of this service, and also the OIDC issuer — changing it
# invalidates the registered clients (Forgejo, Grist) and their redirect URIs.
Environment=APP_URL=https://auth.lab.pacmag.cz
# Session cookie domain. Must be pacmag.cz, not lab.pacmag.cz: VoidAuth's
# ProxyAuth "covered by" check counts a host as covered only when it's a STRICT
# subdomain of the session domain, so an apex gated host equal to the session
# domain is rejected. Dashy lives on the apex lab.pacmag.cz, so the session domain
# has to be its parent — which still covers every gated host and the apex too.
Environment=SESSION_DOMAIN=pacmag.cz
# Landing page for logout / invite-accept / logo click.
Environment=DEFAULT_REDIRECT=https://lab.pacmag.cz
Environment=APP_TITLE=pacmag lab
Environment=TZ=Europe/Prague
# STORAGE_KEY encrypts secret values at rest (OIDC client secrets, keys). It's a
# secret, so Ansible templates it from the gitignored group_vars/server.yml into
# this 0600 env file rather than committing it inline here. Rotating it makes the
# existing encrypted secrets unreadable.
EnvironmentFile=/var/lib/homelab/voidauth/voidauth.env
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
